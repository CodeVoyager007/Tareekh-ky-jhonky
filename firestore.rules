rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // 0. Global Safety Net
    match /{document=**} {
      allow read, write: if false;
    }

    // Helpers
    function isSignedIn() {
      return request.auth != null;
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    // --- Users Collection ---
    match /users/{userId} {
      function isValidUser(data) {
        return data.uid is string && data.uid.size() <= 128 &&
               data.email is string && data.email.size() <= 200 &&
               (data.displayName == null || (data.displayName is string && data.displayName.size() <= 100)) &&
               (data.photoURL == null || (data.photoURL is string && data.photoURL.size() <= 1000));
      }

      allow get: if isOwner(userId) && isValidId(userId);
      allow create: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && incoming().uid == userId;
      allow update: if isOwner(userId) && isValidId(userId) && isValidUser(incoming()) && 
                    incoming().uid == existing().uid &&
                    incoming().email == existing().email &&
                    incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL', 'lastLogin']);

      // --- Discoveries Subcollection ---
      match /discoveries/{discoveryId} {
        function isValidDiscovery(data) {
          return data.userId == userId &&
                 data.specific_name is string && data.specific_name.size() <= 200 &&
                 data.element_type is string && data.element_type.size() <= 100 &&
                 (data.era == null || (data.era is string && data.era.size() <= 100)) &&
                 (data.cultural_region == null || (data.cultural_region is string && data.cultural_region.size() <= 200)) &&
                 (data.story == null || (data.story is string && data.story.size() <= 5000)) &&
                 (data.image == null || (data.image is string && data.image.size() <= 1000));
        }

        allow list: if isOwner(userId) && isValidId(userId);
        allow get: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidDiscovery(incoming());
        allow delete: if isOwner(userId) && isValidId(userId);
      }

      // --- Stamps Subcollection ---
      match /stamps/{stampId} {
        function isValidStamp(data) {
          return data.userId == userId &&
                 data.siteName is string && data.siteName.size() <= 200 &&
                 data.elementName is string && data.elementName.size() <= 200 &&
                 (data.era == null || (data.era is string && data.era.size() <= 100)) &&
                 (data.thumbnail == null || (data.thumbnail is string && data.thumbnail.size() <= 1000));
        }

        allow list: if isOwner(userId) && isValidId(userId);
        allow get: if isOwner(userId) && isValidId(userId);
        allow create: if isOwner(userId) && isValidId(userId) && isValidStamp(incoming());
      }
    }
  }
}
